#!/usr/bin/env bash
set -euo pipefail

layouts=${1:-}
variants=${2:-}
active_index=${3:-0}
keyboard=${4:-}
remap_b64=${5:-}
config="${HOME}/.config/hypr/input.lua"
symbols_dir="${HOME}/.config/xkb/symbols"
symbols_file="${symbols_dir}/omarchy-keymaps"

if [[ ! "$layouts" =~ ^[[:alnum:]_,-]+$ ]] || [[ -z "$layouts" ]]; then
  printf '%s\n' "Invalid keyboard layout list" >&2
  exit 2
fi

if [[ ! "$variants" =~ ^[[:alnum:]_,-]*$ ]]; then
  printf '%s\n' "Invalid keyboard variant list" >&2
  exit 2
fi

if [[ ! "$active_index" =~ ^[0-9]+$ ]]; then
  printf '%s\n' "Invalid active layout index" >&2
  exit 2
fi

if [[ ! "$remap_b64" =~ ^[A-Za-z0-9+/=]*$ ]]; then
  printf '%s\n' "Invalid keyboard remap payload" >&2
  exit 2
fi

if [[ ! -f "$config" ]]; then
  printf '%s\n' "Hyprland input config not found: $config" >&2
  exit 1
fi

remap_body=""
if [[ -n "$remap_b64" ]]; then
  remap_body=$(base64 -d <<<"$remap_b64")
fi

# Every "key <FROM> { [ To ] };" line comes from Model.js's curated KEY_TABLE,
# never free text, so this augmented layout string is always safe to hand to
# xkbcli/Hyprland as-is. Each group needs its own copy of the augmentation,
# with an explicit 1-based :N group index, so the remap stays active no
# matter which language layout is active (verified with `xkbcli
# compile-keymap`: omitting :N on a multi-group layout is a compile error).
augmented_layouts="$layouts"
if [[ -n "$remap_body" ]]; then
  IFS=',' read -r -a layout_tokens <<<"$layouts"
  augmented=""
  group_index=0
  for token in "${layout_tokens[@]}"; do
    group_index=$((group_index + 1))
    augmented+="${augmented:+,}${token}+omarchy-keymaps(remap):${group_index}"
  done
  augmented_layouts="$augmented"
fi

tmp=""
symbols_scratch=""
cleanup() {
  [[ -n "$tmp" ]] && rm -f "$tmp"
  [[ -n "$symbols_scratch" ]] && rm -rf "$symbols_scratch"
}
trap cleanup EXIT

if [[ -n "$remap_body" ]]; then
  current_options=$(hyprctl getoption input:kb_options -j | jq -r '.str // ""')

  # Validate against a scratch copy of the new symbols file (shadowing any
  # real one via --include) before touching anything real, so a bad remap
  # can never leave the keyboard unusable.
  symbols_scratch=$(mktemp -d)
  mkdir -p "$symbols_scratch/symbols"
  {
    printf '%s\n' 'xkb_symbols "remap" {'
    printf '%s\n' "$remap_body"
    printf '%s\n' '};'
  } >"$symbols_scratch/symbols/omarchy-keymaps"

  if ! xkbcli compile-keymap --test \
      --include "$symbols_scratch" --include-defaults \
      --layout "$augmented_layouts" --variant "$variants" --options "$current_options" \
      >/dev/null 2>&1; then
    printf '%s\n' "Could not validate the requested key remap" >&2
    exit 1
  fi

  mkdir -p "$symbols_dir"
  mv "$symbols_scratch/symbols/omarchy-keymaps" "$symbols_file"
fi

tmp=$(mktemp "${config}.tmp.XXXXXX")

awk -v layouts="$augmented_layouts" -v variants="$variants" '
function indent(line, result) {
  result = line
  sub(/[^[:space:]].*/, "", result)
  return result
}

{
  if ($0 ~ /^[[:space:]]*kb_layout[[:space:]]*=/) {
    print indent($0) "kb_layout = \"" layouts "\",";
    has_layout = 1
    next
  }

  if ($0 ~ /^[[:space:]]*kb_variant[[:space:]]*=/) {
    print indent($0) "kb_variant = \"" variants "\",";
    has_variant = 1
    next
  }

  if ($0 ~ /^[[:space:]]*kb_options[[:space:]]*=/) {
    if (!has_layout) {
      print indent($0) "kb_layout = \"" layouts "\",";
      has_layout = 1
    }
    if (!has_variant) {
      print indent($0) "kb_variant = \"" variants "\",";
      has_variant = 1
    }
  }

  print
}

END {
  if (!has_layout || !has_variant) {
    print ""
    print "-- Managed by omarchy-keymaps."
    print "hl.config({"
    print "  input = {"
    if (!has_layout) print "    kb_layout = \"" layouts "\",";
    if (!has_variant) print "    kb_variant = \"" variants "\",";
    print "  },"
    print "})"
  }
}
' "$config" > "$tmp"

chmod --reference="$config" "$tmp"
mv "$tmp" "$config"
tmp=""
trap - EXIT

hyprctl reload >/dev/null

if [[ -n "$keyboard" ]]; then
  hyprctl switchxkblayout "$keyboard" "$active_index" >/dev/null || true
fi
